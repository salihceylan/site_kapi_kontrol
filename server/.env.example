# server/.env.example  ->  kopyala: cp .env.example .env  (".env" git'e GIRMEZ; sirlari buraya YAZMA)
#
# Bu dosyadaki degerler yer tutucudur. Sirlar bos birakilmistir; gercek
# degerleri yalnizca sunucudaki server/.env dosyasina yazin.

# ---------------------------------------------------------------------------
# Sunucu
# ---------------------------------------------------------------------------
PORT=8080
NODE_ENV=production

# ---------------------------------------------------------------------------
# JWT (ZORUNLU)
# ---------------------------------------------------------------------------
# En az 32 karakter, rastgele bir deger kullanin. Uretmek icin:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# - Bos veya yer tutucu ("change_this_secret" gibi) deger => sunucu BASLAMAZ.
# - 32 karakterden kisa => yalnizca UYARI verilir (sunucu acilir); bakim
#   penceresinde guclu bir secret'a gecin. Secret degisince TUM oturumlar gecersiz olur.
JWT_SECRET=
# Bos birakilirsa varsayilan 30d. Ornek: 12h, 7d, 30d
JWT_EXPIRES_IN=30d

# ---------------------------------------------------------------------------
# Veritabani (PostgreSQL)
# ---------------------------------------------------------------------------
# DB_PASSWORD, depo kokundeki docker-compose.yml icin kullanilan POSTGRES_PASSWORD
# ile ayni olmalidir (POSTGRES_PASSWORD yalnizca BOS veri dizininde ilk kurulumda
# uygulanir; docker compose depo kokundeki .env dosyasini okur, bu dosyayi DEGIL).
# Postgres yalnizca 127.0.0.1'e baglidir; API ayni makinede calismalidir.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=site_kapi_kontrol
DB_USER=postgres
DB_PASSWORD=
# Migration calistiricisi (scripts/migrate.js) kilit bekleme suresi (ms), varsayilan 15000
# MIGRATE_LOCK_TIMEOUT_MS=15000
# Baglanti havuzu / zaman asimlari (donma ve kilitlenmeyi onler; asagidakiler varsayilanlardir):
#   DB_POOL_MAX                 en fazla es zamanli baglanti (varsayilan 12)
#   DB_CONNECT_TIMEOUT_MS       baglanti kurma zaman asimi (varsayilan 5000)
#   DB_STATEMENT_TIMEOUT_MS     tek sorgunun en fazla suresi; kilit beklemeyi de kapsar (varsayilan 30000)
# DB_POOL_MAX=12
# DB_CONNECT_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# E-posta (SMTP) - dogrulama kodu, sifre sifirlama, yonetici daveti
# ---------------------------------------------------------------------------
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=kodver@example.com
SMTP_PASSWORD=
SMTP_FROM=kodver@example.com

# ---------------------------------------------------------------------------
# Genel adresler / CORS
# ---------------------------------------------------------------------------
# PUBLIC_BASE_URL: API'nin disaridan gorunen adresi (QR/davet/sifirlama baglantilari,
#   cihaza giden MQTT/OTA bilgileri). PUBLIC_APP_URL: web uygulamasi adresi (yoksa
#   PUBLIC_BASE_URL kullanilir).
PUBLIC_BASE_URL=https://api.gudeteknoloji.com.tr
PUBLIC_APP_URL=
# CORS_ORIGINS gercekten OKUNUR (src/config/cors.js): virgulle ayrilmis origin
# listesi, ornek: https://app.example.com,https://admin.example.com
# CORS allowlist = CORS_ORIGINS + PUBLIC_APP_URL + PUBLIC_BASE_URL. Allowlist
# disindaki tarayici kaynaklari reddedilir. Mobil (native) istemci CORS kullanmaz.
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Sirket (cihaz etiketleme) uclari: /api/company/*  ve  /qrcodes/*
# ---------------------------------------------------------------------------
# company_qr_tool bu degeri "X-Company-Key" basligiyla gonderir (istemcide ayni
# degisken adi: COMPANY_API_KEY). En az 24 karakter, rastgele. Tanimsizsa
# yalnizca super_user JWT ile erisilir.
COMPANY_API_KEY=

# ---------------------------------------------------------------------------
# MQTT (API <-> broker; cihazlar ayri kullanicilarla baglanir)
# ---------------------------------------------------------------------------
MQTT_HOST=mqtt.gudeteknoloji.com.tr
MQTT_PORT=8883
# Broker API ile ayni makinedeyse 127.0.0.1 verin: kopru public DNS'ten (ör. Cloudflare vekili) bagimsiz baglanir;
# sertifika adi/SNI yine MQTT_HOST'a gore dogrulanir. Bos birakirsaniz MQTT_HOST'a baglanir.
# MQTT_CONNECT_HOST=127.0.0.1
MQTT_USER=api_bridge
MQTT_PASSWORD=
# TLS sertifika dogrulamasini KAPATIR. Uretimde ASLA 1/true yapmayin.
MQTT_ALLOW_INSECURE_TLS=false

# Mosquitto passwd/ACL senkronu (bkz. MQTT_kurulum.txt 6.1). Komut, root'a ait
# (root:root 0755) /usr/local/bin/kapi-mqtt-sync kopyasindan calismalidir.
MQTT_SYNC_COMMAND=sudo
MQTT_SYNC_ARGS=-n /usr/local/bin/kapi-mqtt-sync
MQTT_SYNC_TIMEOUT_MS=30000
MQTT_SYNC_REQUIRED=true
MQTT_PASSWD_FILE=/etc/mosquitto/passwd
MQTT_ACL_FILE=/etc/mosquitto/acl
# MQTT_LEGACY_USERS=app_client,esp32_door_01
# MOSQUITTO_PASSWD_BIN=mosquitto_passwd

# ---------------------------------------------------------------------------
# Duyuru ve Bildirim (Faz 3a) - ikisi de ISTEGE BAGLI
# ---------------------------------------------------------------------------
# Site basina GUNLUK (Istanbul takvim gunu) en cok kac duyuru e-postasi kuyruga alinsin (varsayilan 500). Asan adresler
# "capped" olur; yayin engellenmez. Gecersiz deger varsayilana doner.
# ANNOUNCEMENT_EMAIL_MAX_PER_DAY_PER_SITE=500
# Kotuye kullanim sinirlari (hepsi ISTEGE BAGLI; gecersiz ya da < 1 deger varsayilana doner):
#  - bir sitenin bir Istanbul gununde yayinlanan + o gune zamanlanan toplam duyuru sayisi (asilirsa 409 ANNOUNCEMENT_DAILY_LIMIT)
# ANNOUNCEMENT_MAX_PER_DAY_PER_SITE=30
#  - ayni sayim, yalnizca ACIL + e-postali duyurular (acil duyuru kisi e-posta tercihini atlar; kotuye kullanimi sinirlar)
# ANNOUNCEMENT_URGENT_EMAIL_MAX_PER_DAY_PER_SITE=3
#  - bir yoneticinin son 1 saatte yayinladigi e-postali duyuru sayisi (asilirsa 409 ANNOUNCEMENT_HOURLY_LIMIT)
# ANNOUNCEMENT_EMAIL_PUBLISH_MAX_PER_HOUR_PER_USER=10
#  - tek bir e-posta adresine TUM sitelerde bir Istanbul gununde gidecek duyuru e-postasi (fazlasi "capped")
# ANNOUNCEMENT_EMAIL_MAX_PER_DAY_PER_ADDRESS=3
# Sakin / daire kullanicisi / kurul gelen kutusunda (liste, okunmamis sayilari, bildirim ozeti, acil serit) YALNIZ son N gunde yayinlanan
# duyurular gorunur (varsayilan 90). 0 ya da gecersiz deger = SINIRSIZ (eskiler kalir); en cok 3650. Okunmamis ACIL duyuru okunana kadar
# gorunur (365 gunden eskiyse gorunmez). Veri SILINMEZ: yonetici listesi, okundu kayitlari ve e-posta kuyrugu etkilenmez.
# ANNOUNCEMENT_INBOX_RETENTION_DAYS=90
# E-posta adres ozetleri (tuzlu SHA-256) ve "abonelikten cik" baglantisi imzasi icin sir. Tanimli degilse JWT_SECRET'tan turetilir.
# DIKKAT: degistirirseniz eski ozetler/baglantilar eslesmez (abonelikten cikma listesi sifirlanmis gibi olur); canlida degistirmeyin.
# ANNOUNCEMENT_EMAIL_SECRET=
# Sir DONDURME: eski sir(lar) virgulle yazilir; bastirma kontrolleri ve eski e-postalardaki abonelik baglantilari eski sirlarla da denenir,
# YENI ozet / imzalar yalniz guncel sirla uretilir. Ozel sir tanimsizken JWT_SECRET donduruluyorsa ESKI JWT_SECRET degeri buraya yazilmali.
# 8 karakterden kisa deger kullanilmaz (JWT_SECRET'a dusulur, uyari loglanir). Tum sirlar BAS/SON BOSLUKSUZ (kirpilmis) degerle kullanilir.
# DIKKAT - PREVIOUS'tan bir sir SILMEK: o sirla atilmis eski e-posta baglantilari ve (guncel tuza henuz tasinmamis) abonelikten cikma kayitlari
# gecersiz olur. Sunucu, eski tuzla eslesen bir bastirmayi kitle anlik goruntusu / kuyruk talebi sirasinda GUNCEL tuzla da yazar (sessiz gecis),
# yani bir sirri silmeden once en az bir gonderim turu PREVIOUS'ta birakin. PREVIOUS degerleri VIRGUL ICEREMEZ (virgul ayiricidir).
# ANNOUNCEMENT_EMAIL_SECRET_PREVIOUS=

# ---------------------------------------------------------------------------
# Aidat ve Finans Faz 4b (makbuz, gecikme tazminati, gider, borc hatirlatma) - hepsi ISTEGE BAGLI
# ---------------------------------------------------------------------------
# Makbuz dogrulama kodu (HMAC) sirri; en az 16 karakter. Tanimli degilse JWT_SECRET'tan TURETILIR. Kod makbuz satirinda saklanir; sirri
# degistirmek eski makbuzlari etkilemez (yalniz yeni makbuzlar yeni sirla kodlanir). Ikisi de yoksa makbuz duzenlenemez (503 RECEIPT_UNAVAILABLE).
# FINANCE_RECEIPT_SECRET=
# Borc hatirlatma: site basina GUNLUK (Istanbul gunu) en cok kac e-posta kuyruga alinsin (varsayilan 300; 0 = gonderim kapali). Gecersiz deger
# varsayilana doner. Tazminat ve hatirlatma ayrica SITENIN hukuk onayi bayragini ister (sites.legal_ok, migration 114; mevcut siteler ACIK, YENI siteler
# KAPALI baslar; yalniz super kullanici: PUT /admin/sites/:siteCode/finance-legal-gate; satis oncesi avukat onayi ile acilir).
# FINANCE_REMINDER_MAX_PER_DAY_PER_SITE=300
# Rapor / disa aktarma / onizleme esli zamanli sinirlari (hepsi istege bagli; gecersiz ya da 0 deger varsayilana doner). Dolu yuvada 503 REPORT_BUSY.
# Site basina eszamanli yonetici raporu / disa aktarma (varsayilan 2):
# FINANCE_REPORT_MAX_CONCURRENT_PER_SITE=2
# Rapor ve onizleme islemlerinin statement_timeout degeri, ms (varsayilan 20000):
# FINANCE_REPORT_STATEMENT_TIMEOUT_MS=20000
# Site basina eszamanli tazminat / hatirlatma onizlemesi (varsayilan 2):
# FINANCE_PREVIEW_MAX_CONCURRENT_PER_SITE=2
# Site basina eszamanli sakin ekstresi (varsayilan 8):
# FINANCE_RESIDENT_STATEMENT_MAX_CONCURRENT_PER_SITE=8
# Yalniz testler: SERVER_SKIP_START=1 uygulamayi agi/veritabanini acmadan ice aktarir. NODE_ENV=production iken YOK SAYILIR ve hata loglanir;
# .env dosyasina YAZMAYIN.
# E-postadaki "abonelikten cik" baglantisinin koku (PUBLIC_APP_URL, yoksa PUBLIC_BASE_URL, yoksa https://api.gudeteknoloji.com.tr).
# Genel uc nginx uzerinden /public/ yolunu sunucuya iletmelidir.
# 1/true/yes: zamanlanmis duyuru yayincisi ve e-posta kuyrugu tiki baslamaz (testler/bakim; uretimde tanimlamayin).
# ANNOUNCEMENT_SCHEDULER_DISABLED=1

# ---------------------------------------------------------------------------
# Toplu yukleme / disa aktarma (Faz 2b; docs/PLATFORM_TOPLU_ISLEMLER.md) - hepsi ISTEGE BAGLI
# ---------------------------------------------------------------------------
# 1/true/yes: tum toplu yukleme ve disa aktarma uclari 503 IMPORT_DISABLED doner (acil kapatma).
# BULK_IMPORT_DISABLED=1
# Tek istekte en cok satir (varsayilan ve ust sinir 5000; en az 1).
# BULK_IMPORT_MAX_ROWS=5000

# ---------------------------------------------------------------------------
# Belgeler (dosya deposu; docs/PLATFORM_BELGELER.md)
# ---------------------------------------------------------------------------
# Yukleme dizini (mutlak yol). Depo kokunun (build/web ve server/ dahil) DISINDA olmali; sahibi API kullanicisi, mod 0700 (sudo install -d -o <kullanici> -m 700 ...).
# Tanimsizsa ~/kapi-documents kullanilir. Yedek kumesi = DB dokumu + bu dizin (_tmp ve _orphans haric; .instance dahil); deploy/geri alma bu dizine DOKUNMAZ. Eski ad DOCUMENTS_STORAGE_DIR de kabul edilir.
# DOCUMENTS_DIR=/home/salihceylan/kapi-documents
# Hepsi istege bagli (gecersiz deger varsayilana doner). Dosya basina ust sinir: 10 MiB (25 MiB ustu YOK SAYILIR); nginx client_max_body_size icerik yolunda buna +1 MiB olmali.
# DOCUMENTS_MAX_FILE_BYTES=10485760
# DOCUMENTS_SITE_QUOTA_BYTES=209715200
# DOCUMENTS_MIN_FREE_BYTES=2147483648
# DOCUMENTS_MAX_PER_SITE=2000
# DOCUMENTS_ALLOW_OFFICE=1
# DOCUMENTS_RETENTION_DAYS=30
# DOCUMENTS_UPLOAD_CONCURRENCY=8
# Yetim dosyalar (veritabaninda kaydi olmayan, 24 saatten eski) SILINMEZ, _orphans/ karantinasina alinir ve bu kadar gun sonra silinir (varsayilan 14; 1-365).
# DOCUMENTS_ORPHAN_QUARANTINE_DAYS=14
# 1: bakim isi (bayat yukleme / suresi dolan belge / yetim dosya) baslamaz (testler; uretimde tanimlamayin).
# DOCUMENTS_MAINTENANCE_DISABLED=1

# ---------------------------------------------------------------------------
# Telefon bildirimi (Firebase FCM, Faz 3b-B; docs/PLATFORM_BELGELER.md Bolum B)
# ---------------------------------------------------------------------------
# 1: duyuru yayininda bildirim kuyrugu (outbox) yazilir ve isci FCM'e gonderir. Varsayilan 0 (KAPALI): kuyruga HIC satir yazilmaz,
# cihaz kaydi yine calisir, uygulamaya push_available:false doner. Canliya alirken AYRI ve SON adim olarak acilir.
# PUSH_ENABLED=0
# FCM hizmet hesabi JSON dosyasinin YOLU (icerigi DEGIL). Dosya depo ve server/ DISINDA, sahibi API kullanicisi, mod 0600
# (dizin 0700 / 0750); scp ile yuklenir, sohbete / depoya / e-postaya konmaz, yedege alinmaz. JSON icerigi bu dosyaya, ecosystem.config.cjs'e
# veya PM2 ortamina YAZILMAZ. Okunamaz / bozuksa push yapilandirilmamis sayilir (/admin/push/status configured:false), sunucu yine acilir.
# FCM_SERVICE_ACCOUNT_FILE=/etc/kapi/fcm-service-account.json
# Kullanici basina Istanbul gununde en cok kac "normal" duyuru bildirimi (acil sinirsiz). Varsayilan 8; gecersiz deger varsayilana doner.
# PUSH_MAX_PER_DAY_PER_USER=8
# Site basina Istanbul gununde ACIL olarak gonderilecek en cok duyuru (e-postadaki ANNOUNCEMENT_URGENT_EMAIL_MAX_PER_DAY_PER_SITE ile ayni varsayilan 3).
# Asan acil duyurularin bildirimi "normal" gider (tercih, sessiz saat ve kullanici sinirina tabi). Gecersiz deger varsayilana doner.
# PUSH_URGENT_MAX_PER_DAY_PER_SITE=3
# 1: yalniz push bakim zamanlayicisi baslamaz (testler; uretimde tanimlamayin). ANNOUNCEMENT_SCHEDULER_DISABLED=1 de kapatir.
# PUSH_WORKER_DISABLED=1

# ---------------------------------------------------------------------------
# SMS ile giris ve tarayici bildirimi (migration 063; docs/PLATFORM_ZIYARETCI_KARGO.md) - hepsi ISTEGE BAGLI
# ---------------------------------------------------------------------------
# Saglayici bilgileri / anahtarlar tanimli degilse ilgili ozellik KAPALI kalir ve sunucu yine acilir. Gercek degerleri yalnizca sunucudaki
# server/.env dosyasina yazin; sirlari buraya YAZMAYIN.
# SMS saglayicisi. Su an yalniz "netgsm" desteklenir (buyuk/kucuk harf fark etmez). Bos ya da taninmayan deger = SMS KAPALI:
# GET /auth/sms/status enabled:false doner (istemci SMS girisini kapali sayar), POST /auth/sms/request 503 SMS_UNAVAILABLE verir.
# SMS_PROVIDER=netgsm
# Netgsm API kullanici kodu. NETGSM_USERCODE, NETGSM_PASSWORD ve NETGSM_HEADER'in HEPSI dolu olmali; biri bile bossa SMS KAPALI kalir.
# NETGSM_USERCODE=
# Netgsm API sifresi (SIR).
# NETGSM_PASSWORD=
# Netgsm'de ONAYLI mesaj basligi (SMS'te gonderen adi olarak gorunur).
# NETGSM_HEADER=
# SMS giris kodunun HMAC ozetini imzalayan sir (kod duz saklanmaz; 6 hane, 5 dk gecerli, tek kullanimlik). Tanimli degilse JWT_SECRET kullanilir.
# Oneri: en az 32 karakter, rastgele. Uretmek icin:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Degistirirseniz yalniz o an bekleyen kodlar gecersiz olur (kullanici yeni kod ister).
# SMS_CODE_PEPPER=
# Tarayici bildirimi (Firebase'siz VAPID web push). Anahtar cifti uretmek icin (server/ klasorunde): npx web-push generate-vapid-keys
# WEB_PUSH_VAPID_PUBLIC, WEB_PUSH_VAPID_PRIVATE ve WEB_PUSH_SUBJECT'in HEPSI gecerli olmali; aksi halde tarayici bildirimi KAPALI kalir
# (GET /app/web-push/config enabled:false doner).
# DIKKAT: anahtar cifti degisirse tarayicilardaki mevcut abonelikler calismaz (kullanicilar yeniden abone olmalidir); canlida degistirmeyin.
# VAPID acik anahtar (sir degil; GET /app/web-push/config ile istemciye verilir).
# WEB_PUSH_VAPID_PUBLIC=
# VAPID ozel anahtar (SIR; yalniz sunucuda kalir).
# WEB_PUSH_VAPID_PRIVATE=
# VAPID iletisim adresi: "mailto:" ya da "https://" ile baslamali, aksi halde tarayici bildirimi KAPALI kalir.
# WEB_PUSH_SUBJECT=mailto:destek@example.com

# ---------------------------------------------------------------------------
# Firmware (OTA)
# ---------------------------------------------------------------------------
FIRMWARE_DIR=/var/www/site_kapi_kontrol/server/firmware
# OTA imzasi (Ed25519; tools/ota_imza). Yeni firmware paketleri (POST /admin/firmware/:target/releases) IMZALI olmak zorundadir; sunucu imzayi
# bu GENEL anahtarla dogrular. Genel anahtar sir degildir ama degeri BURAYA yazilmaz (yalniz sunucudaki .env'e). Bicim: PEM (SPKI) ya da
# 32 baytlik ham anahtar (base64 / hex) ya da DER SPKI (base64). Anahtar DONUSU icin en cok 4 genel anahtar bosluk / virgul ile yazilabilir
# (imzadaki key_id hangisinin kullanilacagini secer). OZEL anahtar ASLA sunucuya, depoya ya da bu dosyaya konmaz (imzalama bakim
# makinesinde yapilir). Tanimsizsa imzali yukleme ucu 503 verir; sahadaki imzasiz yayinlar sunulmaya devam eder.
# OTA_PUBLIC_KEY=
# Gecis anahtari: 1 (varsayilan) = mevcut IMZASIZ manifestler sunulmaya devam eder (cihazlar kopru surumunu alabilsin). Sahadaki cihazlar imzali
# surume gectikten sonra 0 yapin: imzasiz manifest artik sunulmaz. Imzali manifestlerin imzasi her istekte OTA_PUBLIC_KEY ile sunucuda da dogrulanir.
# OTA_SERVE_UNSIGNED=1
# Yuklenebilecek en buyuk firmware boyutu (bayt; varsayilan 1966080 = OTA bolumu 0x1E0000). nginx client_max_body_size bunun ustunde olmali.
# OTA_MAX_FIRMWARE_BYTES=1966080

# ---------------------------------------------------------------------------
# Yalnizca GELISTIRME / bakim betikleri (server/scripts/*) - uretimde tanimlamayin
# ---------------------------------------------------------------------------
# test_*.js / check_*.js / apply_*.js betikleri bu bayrak 1 degilse calismaz
# (gercek veritabanina kazara dokunmamak icin).
# ALLOW_DEV_SCRIPTS=1
# trigger_ota*.js betikleri (MQTT_USER/MQTT_PASSWORD ile ayni degerleri kullanir):
# MQTT_URL=mqtts://mqtt.gudeteknoloji.com.tr:8883
# Site Drive deposu (D1, modul drive_storage): Google Cloud OAuth istemcisi (drive.file kapsami). Bos ise arayuz "Yakinda..." der.
# DRIVE_CLIENT_ID=
# DRIVE_CLIENT_SECRET=
# DRIVE_REDIRECT_URI=https://api.gudeteknoloji.com.tr/drive/oauth/callback
# DRIVE_TOKEN_KEY=<en az 32 karakter rastgele; yenileme belirtecini sifreler, kaybolursa siteler Drive'i yeniden baglar>
# Online tahsilat saglayici baglantisi (116): sirlar (API anahtari vb.) bu anahtarla sifreli saklanir. Yoksa uclar 503 PAYMENT_NOT_CONFIGURED doner.
# PAYMENT_SECRET_KEY=<en az 32 karakter rastgele; kaybolursa siteler saglayici anahtarlarini yeniden girer>
# MESSAGING_SECRET_KEY=<en az 32 karakter rastgele; site basina SMS / WhatsApp sirlarini (kullanici kodu, sifre, erisim belirteci) sifreler. Yoksa baglanti kaydedilemez (503); kaybolursa siteler baglantiyi yeniden girer. Deger buraya YAZILMAZ>
# DRIVE_PENDING_DIR=  (baglanti kopukken bekleme alani; varsayilan ~/kapi-drive-pending). Buradaki dosyalar KENDILIGINDEN SILINMEZ: yalniz Drive teyidinden sonra gider (K6); bu klasoru elle temizlemeyin.
# ---------------------------------------------------------------------------
# Google / Apple ile giris (oauth_login.js). Istemci kimligi tanimli degilse o saglayicinin girisi KAPALIDIR
# (503 OAUTH_NOT_CONFIGURED; belirtecin "aud" alani yalniz bu listeyle dogrulanir). Birden cok kimlik virgulle.
# Web'de Google erisim belirteci icin web istemci kimligi de listede olmali.
# GOOGLE_CLIENT_IDS=<android>,<ios>,<web>
# APPLE_CLIENT_IDS=<bundle id>,<services id>
# Yerel/mobil giriste istemci nonce'u zorunlu olsun mu: 1/true/all = tum saglayicilar; ya da liste (ornek: apple).
# google_sign_in 7.x'e gecilene kadar Google mobil nonce gondermez: o zamana kadar en fazla OAUTH_REQUIRE_NONCE=apple.
# OAUTH_REQUIRE_NONCE=
