<?xml version="1.0" encoding="UTF-8"?>
<!--
  YER TUTUCU - gerçek değer YOK. Gerçek dosya: Firebase Konsolu > Proje ayarları > iOS uygulaması
  (bundle ID tr.com.gudeteknoloji.siteyonetim) > GoogleService-Info.plist indir -> ios/Runner/GoogleService-Info.plist
  ve Xcode'da Runner hedefine ekle (git'e GİRMEZ, .gitignore). iOS için ayrıca: Push Notifications + Background
  Modes > Remote notifications (+ acil için Time Sensitive Notifications) yetenekleri, APNs .p8 anahtarının
  Firebase'e yüklenmesi ve gerçek cihaz gerekir (docs/PLATFORM_BELGELER.md B0, B9). Analytics KAPALI kalır.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>API_KEY</key>
	<string>API-ANAHTARI-YER-TUTUCU</string>
	<key>GCM_SENDER_ID</key>
	<string>000000000000</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>BUNDLE_ID</key>
	<string>tr.com.gudeteknoloji.siteyonetim</string>
	<key>PROJECT_ID</key>
	<string>firebase-proje-kimligi</string>
	<key>STORAGE_BUCKET</key>
	<string>firebase-proje-kimligi.firebasestorage.app</string>
	<key>IS_ADS_ENABLED</key>
	<false/>
	<key>IS_ANALYTICS_ENABLED</key>
	<false/>
	<key>IS_APPINVITE_ENABLED</key>
	<true/>
	<key>IS_GCM_ENABLED</key>
	<true/>
	<key>IS_SIGNIN_ENABLED</key>
	<true/>
	<key>GOOGLE_APP_ID</key>
	<string>1:000000000000:ios:0000000000000000000000</string>
</dict>
</plist>
