# company_qr_tool ortam ayarlari (ornek).
#
# Kullanim: bu dosyayi ayni klasorde ".env" adiyla kopyalayin ve degerleri doldurun.
# ".env" git'e GIRMEZ (kok .gitignore). Sirlari bu ornek dosyaya YAZMAYIN.
# Ayni degiskenler Windows kullanici ortam degiskeni olarak da verilebilir
# (ortam degiskeni .env'deki degeri ezer):  setx COMPANY_API_KEY "..."

# --- Sunucu sirket uclari (zorunlu: cihaz kaydet / liste / sil) ---
# Sunucudaki server/.env icindeki COMPANY_API_KEY ile AYNI deger.
# Tanimsizsa uygulama sunucuya hic istek gondermez ve anlasilir bir uyari verir.
# Anahtar yalnizca HTTPS (veya localhost) uzerinden "X-Company-Key" basligiyla gonderilir.
COMPANY_API_KEY=

# --- API adresi (varsayilan: https://api.gudeteknoloji.com.tr) ---
# AHBU_API_URL=https://api.gudeteknoloji.com.tr
# Duz HTTP yedek uc VARSAYILAN KAPALI. Yalnizca yerel gelistirme icin:
# AHBU_API_FALLBACK_URL=http://127.0.0.1:3000

# --- Firmware'i VPS'e SFTP ile gonderme (varsayilanlar parantez icinde) ---
# AHBU_VPS_HOST=178.210.161.55
# AHBU_VPS_PORT=22667
# AHBU_VPS_USER=salihceylan
# AHBU_VPS_FIRMWARE_DIR=/var/www/site_kapi_kontrol/server/firmware

# Sunucu kimligi known_hosts ile DOGRULANIR (bilinmeyen sunucuya baglanilmaz).
# Varsayilan dosya: ~/.ssh/known_hosts  (ilk kurulum talimati README.md'de)
# SSH_KNOWN_HOSTS=C:\Users\<kullanici>\.ssh\known_hosts

# Kimlik dogrulama: anahtar (ONERILEN) veya parola.
# SSH_KEY_FILE=C:\Users\<kullanici>\.ssh\id_ed25519
# SSH_KEY_PASSPHRASE=
# Anahtar tanimli degilse parola: bu degisken veya uygulamanin sordugu diyalog.
# AHBU_VPS_PASSWORD=
