{
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.dart_tool/**": true,
    "**/build/**": true,
    "**/.pio/**": true,
    "**/.gradle/**": true
  },
  "git.autorefresh": true,
  "git.openRepositoryInParentFolders": "always"
}
