{
  "C_Cpp.default.configurationProvider": "platformio.platformio-ide",
  "platformio-ide.autoRebuildAutocompleteIndex": true,
  "python.defaultInterpreterPath": "${workspaceFolder}/company_qr_tool/.venv/Scripts/python.exe",
  "python.analysis.extraPaths": [
    "${workspaceFolder}/company_qr_tool"
  ],
  "python.analysis.typeCheckingMode": "off",
  "files.watcherExclude": {
    "**/.git/**": true,
    "**/node_modules/**": true,
    "**/.dart_tool/**": true,
    "**/build/**": true,
    "**/.pio/**": true,
    "**/.gradle/**": true
  },
  "git.autorefresh": false,
  "git.autoFetch": false,
  "git.openRepositoryInParentFolders": "always"
}
