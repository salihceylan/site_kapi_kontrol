# ~/.config/kapi-offsite.env  -- dış kopya (YALNIZCA şifreli yedekler gönderilir)  -- izin: chmod 600
# Bu dosya yoksa offsite_push.sh sessizce atlar ve izleme "dış kopya yapılandırılmadı" uyarısı verir.
# Kurulum ve seçenekler: docs/OPERASYON_YEDEK_IZLEME.md  (bölüm "Dış kopya")

# Yöntem: rsync (ssh üzerinden, ya da yerel/bağlanmış bir dizine)  |  sftp  |  rclone
OFFSITE_METHOD=rsync

# rsync / sftp:  kullanici@sunucu:/hedef/dizin
# rclone:        uzakuc_adi:klasor        (örn. b2:kapi-yedek, drive:kapi-yedek)
# yerel dizin:   /mnt/harici/kapi-yedek   (rsync yöntemi; NAS/USB bağlama noktası)
OFFSITE_TARGET=yedek@yedek-sunucusu.example.com:/yedekler/kapi

# ssh için (rsync/sftp): bağlantı noktası ve bu iş için ayrılmış PAROLASIZ anahtar
OFFSITE_SSH_PORT=22
OFFSITE_SSH_KEY=/home/salihceylan/.ssh/kapi_offsite

# Saklama: dış kopyalar en çok bu kadar gün tutulur (varsayılan 210; gizlilik metnindeki saklama süresiyle uyumlu olmalı).
# Gönderim başarılı olduktan sonra uzak taraftaki bu yaştan eski günlük veritabanı ve yapılandırma yedekleri silinir
# (rsync: yerel dizin veya ssh üzerinden, rclone: `rclone delete --min-age`). sftp'de uzak silme YAPILAMAZ: elle silin.
# Firmware arşivleri (kapi_firmware_*) yaşa göre silinmez. 0 = uzak tarafta hiçbir şey silme.
OFFSITE_PRUNE_DAYS=210
