# ~/.config/kapi-ops.env  (isteğe bağlı; yoksa varsayılanlar kullanılır)  -- izin: chmod 600
# Biçim: ANAHTAR=değer (tırnak gerekmez, boşluklu değerlerde tırnak kullanılabilir). Betikler bu dosyayı `source` etmez.

# Uyarı alıcıları. Boşsa: canlı veritabanındaki AKTİF super_user hesapların e-postaları (virgülle ayrılmış liste verilebilir).
#ALERT_EMAIL=ben@example.com,ortak@example.com

# MQTT genel adresi (cihazların bağlandığı ad): dışarıdan TCP ile erişilebilir mi diye denetlenir.
# Bu kontrolü kapatmak için 0 yazın.
#CHECK_MQTT_PUBLIC=1
#MQTT_PUBLIC=mqtt.gudeteknoloji.com.tr:8883
#SERVER_PUBLIC_IP=178.210.161.55

# Ölü adam anahtarı (isteğe bağlı): her BAŞARIYLA tamamlanan healthcheck sonunda bu adrese GET atılır
# (healthchecks.io / UptimeRobot "Heartbeat" gibi). Beklenen aralıkta ping gelmezse o hizmet sizi uyarır:
# sunucu ya da izleme betiği öldüyse içeriden e-posta gelemeyeceği için bu yöntem dışarıdan haber verir.
# Adres gizlidir (gizli bir anahtar içerir); günlüklere yazılmaz. Boşsa kapalı.
#HEARTBEAT_URL=https://hc-ping.com/ornek-uuid

# Eşikler
# Disk doluluğu: varsayılan %70 uyarı / %85 kritik. Günlük büyüme hızı (GB/gün) örneklenir; bu hızla doluma DISK_GROWTH_DAYS günden az
# kaldıysa uyarılır (0 = kapalı). Haftalık kapasite raporu (en büyük 10 tablo + yedek/belge/PM2 günlük boyutları) her pazartesi
# WEEKLY_REPORT_HOUR (İstanbul) saatinden sonra e-posta ile gelir; elle: bash ~/ops/healthcheck.sh --weekly-report
#DISK_WARN=70
#DISK_CRIT=85
#DISK_GROWTH_DAYS=30
#WEEKLY_REPORT_HOUR=8
#BACKUP_MAX_AGE_H=26
#TLS_WARN_DAYS=14
#REMIND_HOURS=6

# Yedek tutma (adet, en az 1; en yeni kopya her zaman korunur). Aynı şifreli içerik daily/weekly/monthly/offsite/config arasında
# sert bağ ile TEK kopya olarak tutulur, bu yüzden dış kopya hazırlık dizini (KEEP_OFFSITE) ek disk harcamaz (yalnız eski kopyalar için).
#KEEP_DAILY=7
#KEEP_WEEKLY=4
#KEEP_MONTHLY=6
#KEEP_OFFSITE=7
#KEEP_FIRMWARE=5

# Belge deposu (DOCUMENTS_DIR) yedeği: son N arşiv tutulur; en yenisi HARİÇ bu yaştan (gün) eskiler silinir;
# dizin bu boyutu (MB) aşarsa yedek exit 2 ile uyarır (tam arşiv yaklaşımının sınırı).
#KEEP_DOCUMENTS=5
#DOCUMENTS_MAX_AGE_DAYS=210
#DOCUMENTS_BACKUP_MAX_MB=3000
# Belge dizini yolu uygulamanın .env'inden (DOCUMENTS_DIR / DOCUMENTS_STORAGE_DIR) okunur; yoksa ~/kapi-documents.
# Yalnızca ops tarafında geçersiz kılmak gerekirse (mutlak yol):
#KAPI_DOCUMENTS_DIR=/home/salihceylan/kapi-documents
